# Freqtrade rules

# Protect all configuration files
config*.json
user_data/config.json
user_data/config*.json

# Database files
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs
logfile.txt
*.log
user_data/logs/*

# Freqtrade generated plots
freqtrade-plot.html
freqtrade-profit-plot.html

# Freqtrade UI
freqtrade/rpc/api_server/ui/*

# Build files
build_helpers/ta-lib/*


# Macos related
.DS_Store


# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so


# Distribution / packaging
.Python
env/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg


# PyInstaller
# Usually these files are written by a Python script from a template
# before being injected into the executable
*.manifest
*.spec


# Installer logs
pip-log.txt
pip-delete-this-directory.txt


# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/


# Translations
*.mo
*.pot


# Django stuff
local_settings.py


# Flask stuff
instance/
.webassets-cache


# Scrapy
.scrapy


# memray
memray-*


# Sphinx documentation
docs/_build/


# Mkdocs
site/


# PyBuilder
target/


# Jupyter Notebook
*.ipynb_checkpoints


# pyenv
.python-version


# Environment variables / local environments
.env


# IDE settings
.idea
.vscode


# Cache files
.*_cache/


# Exceptions
!*.gitkeep


# Freqtrade example configurations
!config_examples/config_binance.example.json
!config_examples/config_full.example.json
!config_examples/config_kraken.example.json
!config_examples/config_freqai.example.json


# Docker compose files
docker-compose-*.yml