        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
    "name": "bybit",

        "key": "Yw3YT52zeFT31ynaCZ",

        "secret": "E66W5gyp9HeNNgMhvYDDK4UyV7SBFHG2bDHd",
        "demo_trading": true,

        "ccxt_config": {},

        "ccxt_async_config": {},

        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT"
        ],

        "pair_blacklist": []
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "order_types": {
